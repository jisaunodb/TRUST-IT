# Server Configuration
PORT=3000
NODE_ENV=development
FRONTEND_URL="http://localhost:3000"
APP_URL="MY_APP_URL"

# MongoDB Database (MongoDB Atlas or local MongoDB)
# Leave blank in preview to use persistent local JSON storage fallback; set to enable live Mongoose Atlas connection
MONGODB_URI=""

# JWT Authentication
JWT_SECRET="REPLACE_WITH_SECURE_RANDOM_64_CHAR_SECRET"
JWT_EXPIRES_IN="7d"

# Initial Admin Bootstrap (used only on first run when database has zero admins)
ADMIN_SEED_EMAIL="admin@trustit.com.bd"
ADMIN_SEED_PASSWORD="CHANGE_ME_STRONG_PASSWORD"
ADMIN_SEED_NAME="Tariqul Islam"

# Cloudinary Configuration (Image & Resume Upload)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Client Public Env Vars
VITE_API_URL="/api"
VITE_CLOUDINARY_CLOUD_NAME=""
